#!/bin/bash
# Pre-commit hook that runs lintrunner
# Prevents commit if linting fails

echo "🔍 Running linter checks..."

# Run lintrunner
if ! lintrunner -a; then
    echo ""
    echo "❌ Linting failed! Commit aborted."
    echo "🔧 Fix the issues above and try again."
    exit 1
fi

echo "✓ Linting passed!"
exit 0
