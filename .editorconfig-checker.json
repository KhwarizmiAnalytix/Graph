{
  "$schema": "https://raw.githubusercontent.com/editorconfig-checker/editorconfig-checker/v3.8.0/.editorconfig-checker.schema.json",
  "Verbose": false,
  "Debug": false,
  "IgnoreDefaults": false,
  "SpacesAfterTabs": false,
  "NoColor": false,
  "Exclude": [
    "^ThirdParty/",
    "^Tools/",
    "/experimental/",
    "/Experimental/",
    "/generated/",
    "^build(_[^/]+)?/",
    "^dist/",
    "^\\.lintbin/",
    "^\\.venv/",
    "^venv/",
    "^\\.git/",
    "^\\.cursor/",
    "^\\.augment/",
    "^\\.vscode/",
    "\\.png$",
    "\\.jpg$",
    "\\.jpeg$",
    "\\.gif$",
    "\\.ico$",
    "\\.pdf$",
    "\\.gz$",
    "\\.zip$",
    "\\.so$",
    "\\.dylib$",
    "\\.dll$",
    "\\.a$",
    "\\.lib$",
    "\\.o$",
    "\\.obj$",
    "\\.pyc$",
    "\\.pyd$",
    "\\.whl$",
    "\\.parquet$",
    "\\.bin$",
    "\\.pt$",
    "\\.onnx$",
    "\\.DS_Store$",
    "^\\.dmypy\\.json$"
  ],
  "Disable": {
    "EndOfLine": false,
    "Indentation": false,
    "Charset": false,
    "MaxLineLength": false,
    "IndentSize": true,
    "InsertFinalNewline": true,
    "TrimTrailingWhitespace": true
  }
}
